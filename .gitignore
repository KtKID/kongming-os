# 顶层 node_modules（项目根的依赖缓存，与 web/node_modules 分别管理）
/node_modules/
.pip-cache

# zcode CLI 本地会话数据（plans 等，每个 clone 各自维护，不入仓）
.zcode/

# dev-checklist 工作中的临时状态 flag（带 hash 后缀，跑完即丢弃）
.dev-checklist.md.flag-*.tmp

# Node 工作区（与 DSH 一致的根目录布局）
node_modules/
.env
*.tsbuildinfo
.DS_Store

# tsc 增量构建把产物写到 src 旁（rewriteRelativeImportExtensions），不提交；
# 判定以 DSH 原仓库为准：DSH 中不存在的 src 下 .js/.d.ts/.map 均为本地生成物
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
packages/**/src/**/*.d.ts.map
vendor/**/src/**/*.js
vendor/**/src/**/*.js.map
vendor/**/src/**/*.d.ts
vendor/**/src/**/*.d.ts.map

# Kongming 的 DSH 运行数据、迁移备份与 profile 依赖。
/.kmh/
/profiles/*/node_modules/
/profiles/*/cordis.yml
/profiles/*/pnpm-lock.yaml
/packages/*/lib/

# Codex 官方完整运行包保存在本机，版本与启动器由插件跟踪。
/packages/codex-cli/bin/0.163.0-alpha.10.2/

# codegraph 本地索引缓存与可视化产物（SQLite 索引 + 生成的 HTML，不入仓）
/.codegraph/

# reports 下全部图片保留本地，报告与经核对的文本证据继续跟踪。
/reports/**/*.[pP][nN][gG]
/reports/**/*.[jJ][pP][gG]
/reports/**/*.[jJ][pP][eE][gG]
/reports/**/*.[gG][iI][fF]
/reports/**/*.[wW][eE][bB][pP]
/reports/**/*.[sS][vV][gG]
/reports/**/*.[aA][vV][iI][fF]
