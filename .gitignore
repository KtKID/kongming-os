# 参考项目源码（用于借鉴，不纳入版本控制）
other/

# 开发期 plugin 软链（如 plugins/client/XSpace 是指向另一个 git 仓库的 symlink），
# commit 进来会让其他人 clone 时破链 —— 永久排除。
plugins/

# macOS
.DS_Store

