            ROUTE[route.py - WS 路由]
            SVC[service.py - SDK 调用]
            NORM[normalizer.py - 消息归一]
            APR[approval.py - 审批回调]
            SM[session_manager.py - 活跃会话]
        end
        subgraph EXIST["现有 web 主线 (generic_chat)"]
            GC[OpenAI/Anthropic Provider]
        end
    end

    subgraph CLI_PROC["claude_agent_sdk 子进程"]
        SDK[claude CLI]
    end

    subgraph CLOUD["Anthropic API"]
        API[Claude API]
    end

    UI <-->|WebSocket JSON| WS
    WS --> ROUTE
    ROUTE --> SVC
