flowchart LR
    subgraph IN["命令流入（stdin）"]
        S1[start]
        S2[resolve_approval]
        S3[interrupt]
        S4[reconnect]
        S5[shutdown]
    end

    PARSE[Command Parser]

    subgraph SDK_LAYER["SDK 接入"]
        BRIDGE[SDK Bridge]
        APR[Approval Bridge]
    end

    subgraph SDK_MSG["SDK Message 流"]
        M1[AssistantMessage]
        M2[UserMessage with ToolResult]
        M3[SystemMessage init]
        M4[SystemMessage hook noise]
        M5[ResultMessage]
        M6[StreamEvent]
    end

    TRANS[Message Translator<br/>状态跟踪 + 去重]

    subgraph OUT_LAYER["Output Writer"]
        OUT[JSONL 序列化<br/>+ protocolVersion]
    end

    subgraph EVT["事件流出（stdout）"]
        E1[claude_sidecar_ready]
        E2[claude_session_created]
        E3[claude_assistant_*_delta/final]
        E4[claude_tool_*]
        E5[claude_approval_*]
        E6[claude_run_finished/failed/interrupted]
        E7[claude_transport_error]
    end

    S1 --> PARSE
    S2 --> PARSE
    S3 --> PARSE
    S4 --> PARSE
    S5 --> PARSE

    PARSE --> BRIDGE
    PARSE -.->|resolve_approval| APR
    BRIDGE <-->|can_use_tool| APR

    BRIDGE --> M1
    BRIDGE --> M2
    BRIDGE --> M3
    BRIDGE --> M4
    BRIDGE --> M5
    BRIDGE --> M6

    M1 --> TRANS
    M2 --> TRANS
    M3 --> TRANS
    M4 -.->|默认丢弃| DROP[/丢弃/]:::drop
    M5 --> TRANS
    M6 --> TRANS

    TRANS --> OUT
    APR --> OUT

    OUT --> E1
    OUT --> E2
    OUT --> E3
    OUT --> E4
    OUT --> E5
    OUT --> E6
    OUT --> E7

    style IN fill:#e3f2fd,stroke:#1565c0
    style SDK_LAYER fill:#fce4ec,stroke:#ad1457
    style SDK_MSG fill:#f3e5f5,stroke:#6a1b9a
    style OUT_LAYER fill:#e8f5e9,stroke:#2e7d32
    style EVT fill:#e8f5e9,stroke:#2e7d32

    classDef drop fill:#ffebee,stroke:#c62828,stroke-dasharray:3 3
