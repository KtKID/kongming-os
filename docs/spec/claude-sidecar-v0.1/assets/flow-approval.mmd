sequenceDiagram
    participant SDK as claude_agent_sdk
    participant APR as Approval Bridge
    participant OUT as Output Writer
    participant DRV as XSpace Driver
    participant USER as 用户
    participant CMD as Command Parser
    participant TRANS as Message Translator

    SDK->>APR: can_use_tool(toolName, input, ctx)
    activate APR
    Note over APR: requestId = ctx.tool_use_id
    APR->>APR: 创建 Future for requestId
    APR->>OUT: claude_approval_requested{requestId, toolName, input}
    OUT-->>DRV: stdout
    DRV->>USER: 显示审批 UI
    USER-->>DRV: allow / deny
    DRV->>CMD: stdin: resolve_approval{requestId, approved, message?, updatedInput?}
    CMD->>APR: 路由到对应 Future
    APR->>APR: Future.set_result(command)

    alt approved=true
        APR->>OUT: claude_approval_resolved{requestId}
        APR-->>SDK: PermissionResultAllow(updated_input)
        SDK->>SDK: 继续执行工具
        SDK-->>TRANS: AssistantMessage(ToolUseBlock) → claude_tool_started
        SDK-->>TRANS: UserMessage(ToolResultBlock) → claude_tool_finished
    else approved=false
        APR->>OUT: claude_approval_denied{requestId, message}
        APR-->>SDK: PermissionResultDeny(message, interrupt=False)
        SDK->>SDK: 跳过工具，继续 run
        Note over SDK,TRANS: SDK 自动产生 ToolResultBlock(is_error=True)<br/>tool_use_id == requestId
        SDK-->>TRANS: UserMessage(ToolResultBlock)
        TRANS->>TRANS: 检查 deny 集合 - 命中
        Note over TRANS: 丢弃，不发 claude_tool_finished (E8)
    end
    deactivate APR
