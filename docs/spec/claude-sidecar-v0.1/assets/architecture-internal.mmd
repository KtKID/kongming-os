flowchart TB
    STDIN([stdin]):::ext
    STDOUT([stdout]):::ext

    ENT[Entrypoint - 主循环]
    CMD[Command Parser - 5 类请求解析]
    LIFE[Lifecycle Manager - interrupt/reconnect/shutdown]
    SDKB[SDK Bridge - ClaudeSDKClient 封装]
    APR[Approval Bridge - can_use_tool 异步对接]
    TRANS[Message Translator - SDK Msg → SidecarEvent - 含状态跟踪 + 去重]
    OUT[Output Writer - JSONL 序列化]

    STDIN --> ENT
    ENT --> CMD
    CMD --> LIFE
    CMD --> SDKB
    LIFE --> SDKB
    SDKB --> TRANS
    TRANS --> OUT
    SDKB <--> APR
    APR --> OUT
    OUT --> STDOUT

    classDef ext fill:#fafafa,stroke:#888,stroke-dasharray:3 3
    style ENT fill:#e3f2fd,stroke:#1565c0
    style CMD fill:#e3f2fd,stroke:#1565c0
    style LIFE fill:#fff8e1,stroke:#f57c00
    style SDKB fill:#fce4ec,stroke:#ad1457
    style APR fill:#fce4ec,stroke:#ad1457
    style TRANS fill:#f3e5f5,stroke:#6a1b9a
    style OUT fill:#e8f5e9,stroke:#2e7d32
