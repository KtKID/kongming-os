sequenceDiagram
    participant DRV as XSpace Driver
    participant ENT as Entrypoint
    participant OUT as Output Writer
    participant DEPS as Python imports

    DRV->>ENT: spawn python -m claude_sidecar
    activate ENT
    ENT->>DEPS: import claude_agent_sdk, asyncio, ...
    DEPS-->>ENT: ready
    ENT->>OUT: write claude_sidecar_ready
    OUT-->>DRV: stdout: claude_sidecar_ready
    Note over DRV: 收到 ready 才发 start
    ENT->>ENT: enter stdin read loop
    deactivate ENT
