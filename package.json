{
  "name": "@kmh/workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "setup": "node scripts/kmh.mjs setup",
    "build": "node scripts/kmh.mjs build",
    "build:kmh": "pnpm --filter @kmh/kmh-echo --filter @kmh/zcode-cli --filter @kmh/codex-cli --filter @kmh/runtime-log --filter @kmh/web-surface-zh build",
    "cli": "node scripts/kmh.mjs cli",
    "web": "node scripts/kmh.mjs web",
    "config:web": "node scripts/kmh.mjs web --dump-config",
    "sdk": "node scripts/kmh.mjs sdk",
    "dsh": "node scripts/kmh.mjs dsh",
    "profiles": "node scripts/kmh.mjs profiles",
    "hooks": "node scripts/install-hooks.mjs",
    "test": "node --test --test-concurrency=1 tests/runtime/*.test.mjs packages/codex-cli/test/*.test.mjs",
    "pretest": "pnpm build:kmh",
    "typecheck": "pnpm typecheck:kmh && pnpm --dir third_party/dsh run typecheck",
    "typecheck:kmh": "pnpm --filter @kmh/kmh-echo --filter @kmh/zcode-cli --filter @kmh/codex-cli --filter @kmh/runtime-log --filter @kmh/web-surface-zh typecheck",
    "lint": "bash -n kmh.sh && node --check scripts/kmh.mjs && node --check scripts/runtime-home.mjs && node --check scripts/runtime-logs.mjs && node --check scripts/install-hooks.mjs && pnpm --filter @kmh/kmh-echo --filter @kmh/zcode-cli --filter @kmh/codex-cli --filter @kmh/runtime-log --filter @kmh/web-surface-zh lint",
    "format:check": "pnpm --filter @kmh/kmh-echo --filter @kmh/zcode-cli --filter @kmh/codex-cli --filter @kmh/runtime-log --filter @kmh/web-surface-zh format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "prettier": "^3.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.0"
  }
}
