{
  "name": "@kmh/kmh-team",
  "version": "0.1.0",
  "type": "module",
  "description": "Persistent KMH agent roles and mention-activated team conversations",
  "license": "MIT",
  "files": [
    "lib/src",
    "lib/client.js",
    "README.md",
    "lib/browser-types/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/browser-types/src/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/src/protocol/index.d.ts",
      "default": "./lib/src/protocol/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "pretest": "pnpm build",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier src tsconfig*.json package.json README.md --check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.1"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../third_party/dsh/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../third_party/dsh/vendor/schemastery",
    "@deepseek-ai/dsh-brand": "link:../../third_party/dsh/packages/util/brand",
    "@deepseek-ai/dsh-agent": "link:../../third_party/dsh/packages/core/agent",
    "@deepseek-ai/dsh-session": "link:../../third_party/dsh/packages/core/session",
    "@deepseek-ai/dsh-tools": "link:../../third_party/dsh/packages/core/tools",
    "@deepseek-ai/dsh-llm": "link:../../third_party/dsh/packages/llm/llm",
    "@deepseek-ai/dsh-subagent": "link:../../third_party/dsh/packages/subagent/subagent",
    "@deepseek-ai/dsh-storage-domain": "link:../../third_party/dsh/packages/storage/storage-domain",
    "@deepseek-ai/dsh-session-projection": "link:../../third_party/dsh/packages/session/session-projection",
    "@deepseek-ai/dsh-api-session-controller": "link:../../third_party/dsh/packages/api/session-controller",
    "@deepseek-ai/dsh-session-query": "link:../../third_party/dsh/packages/session-query/session-query",
    "@deepseek-ai/dsh-settings": "link:../../third_party/dsh/packages/settings/settings",
    "@deepseek-ai/dsh-client-connection": "link:../../third_party/dsh/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../third_party/dsh/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../third_party/dsh/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../third_party/dsh/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../third_party/dsh/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-workspace": "link:../../third_party/dsh/packages/client/ui-workspace",
    "@deepseek-ai/dsh-client-ui-session": "link:../../third_party/dsh/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../third_party/dsh/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../../third_party/dsh/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "link:../../third_party/dsh/packages/client/ui-plugin-manager",
    "@deepseek-ai/dsh-client-ui-input-trigger": "link:../../third_party/dsh/packages/client/ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../third_party/dsh/packages/client/ui-renderer",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "@types/node": "^22.20.0",
    "react": "^18.3.1",
    "@types/react": "^18.3.31",
    "@deepseek-ai/dsh-client-ui-chat": "link:../../third_party/dsh/packages/client/ui-chat"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  }
}
