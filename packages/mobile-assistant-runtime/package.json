{
  "name": "@kmh/mobile-assistant-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "移动助手 SDK 的 preset 绑定、持久会话恢复与审批转发",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier src tsconfig.json package.json README.md --check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "link:../../third_party/dsh/vendor/schemastery",
    "@deepseek-ai/dsh-brand": "link:../../third_party/dsh/packages/util/brand",
    "@deepseek-ai/dsh-agent": "link:../../third_party/dsh/packages/core/agent",
    "@deepseek-ai/dsh-attachment": "link:../../third_party/dsh/packages/attachment/attachment",
    "@deepseek-ai/dsh-llm": "link:../../third_party/dsh/packages/llm/llm",
    "@deepseek-ai/dsh-sdk-protocol": "link:../../third_party/dsh/packages/sdk/protocol",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "link:../../third_party/dsh/packages/sdk/server",
    "@deepseek-ai/dsh-session": "link:../../third_party/dsh/packages/core/session",
    "@deepseek-ai/dsh-session-persistence": "link:../../third_party/dsh/packages/session/session-persistence",
    "@deepseek-ai/dsh-agent-preset-registry": "link:../../third_party/dsh/packages/preset/agent-preset-registry",
    "@deepseek-ai/dsh-user-approval": "link:../../third_party/dsh/packages/interaction/user-approval",
    "zod": "^4.6.5",
    "@deepseek-ai/dsh-scope": "link:../../third_party/dsh/packages/core/scope"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../third_party/dsh/vendor/cordis"
  }
}
